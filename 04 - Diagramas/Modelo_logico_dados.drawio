        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    EQUIPAMENTO ||--o{ OCORRENCIA : \&quot;registra falha em\&quot;\n    TEMPO_BLOCO ||--o{ OCORRENCIA : \&quot;agrupa temporalmente\&quot;\n\n    EQUIPAMENTO {\n        string id_equipamento PK \&quot;Identificador único (ex: MOCHILINKS, RETORNO_VIVOS)\&quot;\n        string nome_ativo \&quot;Nome comercial ou descritivo\&quot;\n        string categoria_familia \&quot;Moshlinks, Multiviews, Clearcoms, Retorno, Streaming\&quot;\n        int limite_toleravel \&quot;Teto de falhas antes do alerta visual (RF10)\&quot;\n    }\n\n    TEMPO_BLOCO {\n        int id_bloco PK \&quot;Chave sequencial do bloco\&quot;\n        date data_referencia \&quot;Data da inspeção técnica (DD/MM/AAAA)\&quot;\n        int mes \&quot;Mês de referência (1 a 12)\&quot;\n        string trimestre_bloco \&quot;Bloco trimestral de consolidação (ex: Q1_2026, Q2_2026)\&quot;\n        int ano \&quot;Ano de referência (2026)\&quot;\n    }\n\n    OCORRENCIA {\n        int id_ocorrencia PK \&quot;Identificador único gerado pós-ETL\&quot;\n        int id_inspecao_origem \&quot;ID da linha original da planilha (1 a 414)\&quot;\n        string id_equipamento FK \&quot;Chave estrangeira do equipamento afetado\&quot;\n        int id_bloco FK \&quot;Chave estrangeira do bloco temporal\&quot;\n        datetime data_ocorrencia \&quot;Timestamp exato da não-conformidade\&quot;\n        string status_conformidade \&quot;NÃO CONFORME ou CONFORME\&quot;\n        string descricao_defeito \&quot;Texto do RESUMO DA OCORRÊNCIA\&quot;\n        float dias_desde_ultima_falha \&quot;Intervalo em dias para cálculo do MTBF\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="xY8AU8XVNd6ZCS0vK7fw-1">
