        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Equipamento {\n        -String codigo\n        -String nome\n        -String categoria\n        -int limiteToleravel\n        +getCodigo() String\n        +getCategoria() String\n        +getLimiteToleravel() int\n    }\n\n    class Ocorrencia {\n        -int id\n        -DateTime dataOcorrencia\n        -String statusConformidade\n        -String descricaoFalha\n        -Equipamento equipamento\n        +getData() DateTime\n        +getStatus() String\n        +getEquipamento() Equipamento\n    }\n\n    class DataLoaderETL {\n        -String caminhoArquivo\n        -String encodingPadrao\n        -DataFrame dfBruto\n        -DataFrame dfNormalizado\n        +carregarPlanilha(caminho, encoding) DataFrame\n        +executarMelt(idVars, valueVars) DataFrame\n        +higienizarDados() DataFrame\n        +validarIntegridadeOrigem() boolean\n    }\n\n    class AnalisadorSAD {\n        -DataFrame dfFalhas\n        -int limiteAlertaPadrao\n        +filtrarPorPeriodo(dataInicio, dataFim) DataFrame\n        +filtrarPorFamilia(categoria) DataFrame\n        +agruparPorBlocoTemporal(meses) DataFrame\n        +calcularTaxaPercentualFalhas() DataFrame\n        +calcularTempoMedioEntreFalhas(codigo) float\n        +gerarRankingCriticidade() DataFrame\n        +verificarAtivosCriticos() List~Equipamento~\n    }\n\n    class VisualizadorDashboard {\n        -AnalisadorSAD motorSAD\n        +plotarGraficoEvolucao(DataFrame) void\n        +plotarGraficoComparativo(DataFrame) void\n        +renderizarJanelaTkinter() void\n        +exibirAlertaVisual(List) void\n    }\n\n    Equipamento \&quot;1\&quot; &lt;-- \&quot;*\&quot; Ocorrencia : afeta\n    DataLoaderETL ..&gt; Ocorrencia : instancia / normaliza\n    AnalisadorSAD o-- DataLoaderETL : consome dados\n    VisualizadorDashboard --&gt; AnalisadorSAD : consulta metricas&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zG-StgFHoq_YAazwc8mg-1">
